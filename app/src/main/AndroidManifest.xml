<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Package visibility (Android 11+). The operator picks a target app from the launcher apps on
      the device, so this app has to be able to see them. Without this declaration
      `queryIntentActivities` returns only the handful of packages already visible to us — on an
      API 36 emulator that is three apps out of twenty-odd — and the filtering happens above the
      match flags, so MATCH_ALL cannot recover them.

      Declared as an intent query rather than QUERY_ALL_PACKAGES: we need exactly the apps a user
      could launch, which is what this expresses, and nothing more. a2h-4ah.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".AppToHtmlApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppToHTML">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.AppToHTML">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".AppToHtmlAccessibilityService"
            android:enabled="true"
            android:exported="false"
            android:label="@string/accessibility_capability_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/apptohtml_accessibility_capability" />
        </service>
    </application>

</manifest>
